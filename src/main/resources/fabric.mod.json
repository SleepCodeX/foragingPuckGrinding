{
  "schemaVersion": 1,
  "id": "foragingpuckgrinding",
  "version": "${version}",
  "name": "Hunting Helper",
  "description": "Track SkyBlock mobs and every Critter Safari area. Open /hh for hunting presets, remaining catches, Hunter trades, recatch pins and party reports.",
  "icon": "assets/foragingpuckgrinding/textures/gui/hivethief/frost.png",
  "authors": [
    "SleepCodeX"
  ],
  "contact": {
    "sources": "https://github.com/SleepCodeX/foragingPuckGrinding",
    "homepage": "https://github.com/SleepCodeX/foragingPuckGrinding#hunting-helper"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      {
        "value": "net.johnceo.sparklingmutuals.SparklingMutuals",
        "adapter": "kotlin"
      }
    ],
    "client": [
      "dev.sleepcodex.foragingpuckgrinding.VexTracerClient"
    ]
  },
  "mixins": [
    "hunting-helper.client.mixins.json",
    "sparkling-mutuals.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.2",
    "fabric-language-kotlin": ">=1.14.1"
  },
  "breaks": {
    "sparkling-mutuals": "*"
  },
  "jars": [
    {
      "file": "META-INF/jars/fabric-api.jar"
    },
    {
      "file": "META-INF/jars/fabric-language-kotlin.jar"
    }
  ],
  "accessWidener": "hunting-helper.accesswidener",
  "custom": {
    "sparkling-mutuals:developer": "false"
  }
}
