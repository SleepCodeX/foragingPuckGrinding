{
  "schemaVersion": 1,
  "id": "foragingpuckgrinding",
  "version": "${version}",
  "name": "Hunting Helper",
  "description": "Hypixel SkyBlock hunting presets, custom nametag and mob-type trackers, and the bundled Sparkling Mutuals Safari suite.",
  "icon": "assets/foragingpuckgrinding/icon.png",
  "authors": [
    "SleepCodeX"
  ],
  "contact": {
    "sources": "https://github.com/SleepCodeX/foragingPuckGrinding"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.sleepcodex.foragingpuckgrinding.VexTracerClient"
    ]
  },
  "mixins": [
    "hunting-helper.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.2",
    "sparkling-mutuals": ">=4.3.7",
    "fabric-language-kotlin": ">=1.14.1"
  },
  "jars": [
    {
      "file": "META-INF/jars/sparkling-mutuals.jar"
    },
    {
      "file": "META-INF/jars/fabric-language-kotlin.jar"
    }
  ]
}
